<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Título principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺 TV Explorer &amp; Transfer"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Estado del servidor -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESTADO: APAGADO"
        android:textColor="#F44336"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Dirección IP para entrar desde la PC -->
    <TextView
        android:id="@+id/tvIpAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Presiona el botón para activar"
        android:textColor="#BBBBBB"
        android:textSize="22sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="36dp" />

    <!-- Botón con foco para el control remoto (D-Pad) -->
    <Button
        android:id="@+id/btnToggleServer"
        android:layout_width="320dp"
        android:layout_height="64dp"
        android:backgroundTint="#2196F3"
        android:text="INICIAR SERVIDOR"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
